---
// src/pages/index.astro
// Página principal — lee el JSON y renderiza las cards
import Layout from "../layouts/Layout.astro";
import FarmaciaCard from "../components/FarmaciaCard.astro";

// ============================================================
// LECTURA DEL JSON generado por Python
// Ocurre en build time — no en el browser
// ============================================================
import farmaciasData from "../data/farmacias.json";

const { farmacias, generado_en, total } = farmaciasData;

// Formateamos la fecha de generación para mostrar en el header
// "2026-04-09T00:09:24.123985" → "09/04/2026, 00:09"
const fechaActualizacion = new Date(generado_en).toLocaleString("es-CL", {
	timeZone: "America/Santiago",
	day: "2-digit",
	month: "2-digit",
	year: "numeric",
	hour: "2-digit",
	minute: "2-digit",
});

// Fecha del turno (viene en el primer registro)
const fechaTurno = farmacias[0]?.fecha ?? "";
---

<Layout title="Farmacias de Turno Chile — Búsqueda por comuna" description="Encuentra farmacias de turno en tu comuna en Chile. Datos oficiales del MINSAL actualizados diariamente con nombre, dirección, teléfono y horario.">
	<!-- ============================================================
       HEADER
       ============================================================ -->
	<header class="bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm">
		<div class="max-w-4xl mx-auto px-4 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
			<div>
				<h1 class="text-xl font-bold text-gray-900 flex items-center gap-2">💊 Farmacias de Turno Chile</h1>
				<p class="text-xs text-gray-500 mt-0.5">
					Datos oficiales MINSAL · Turno del {fechaTurno}
				</p>
			</div>
			<div class="text-xs text-gray-400 text-right">
				Actualizado: {fechaActualizacion}
			</div>
		</div>
	</header>

	<!-- ============================================================
       CONTENIDO PRINCIPAL
       ============================================================ -->
	<main class="max-w-4xl mx-auto px-4 py-6">
		<!-- Buscador -->
		<div class="mb-6">
			<input type="search" id="buscador" placeholder="Buscar por comuna o nombre de farmacia..." maxlength="100" autocomplete="off" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white shadow-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
		</div>

		<!-- Contador de resultados -->
		<div class="mb-4 flex items-center justify-between">
			<p id="contador" class="text-sm text-gray-500">
				Mostrando <span id="contador-numero" class="font-semibold text-gray-700">{total}</span> farmacias de turno
			</p>
			<p class="text-xs text-gray-400">{total} en total</p>
		</div>

		<!-- Grid de cards -->
		<div id="grid-farmacias" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			{farmacias.map((farmacia) => <FarmaciaCard nombre={farmacia.nombre} direccion={farmacia.direccion} telefono={farmacia.telefono} comuna={farmacia.comuna} localidad={farmacia.localidad} hora_apertura={farmacia.hora_apertura} hora_cierre={farmacia.hora_cierre} dia={farmacia.dia} fecha={farmacia.fecha} comuna_busqueda={farmacia.comuna_busqueda} nombre_busqueda={farmacia.nombre_busqueda} />)}
		</div>

		<!-- Mensaje sin resultados — oculto por defecto -->
		<div id="sin-resultados" class="hidden text-center py-16">
			<p class="text-4xl mb-3">🔍</p>
			<p class="text-gray-600 font-medium">No hay farmacias de turno en esa comuna</p>
			<p class="text-gray-400 text-sm mt-1">Intenta con otro nombre o revisa la ortografía</p>
		</div>
	</main>

	<!-- ============================================================
       FOOTER
       ============================================================ -->
	<footer class="border-t border-gray-200 mt-12 py-6 text-center text-xs text-gray-400">
		<p>Datos oficiales del <a href="https://www.minsal.cl" class="underline hover:text-gray-600" target="_blank" rel="noopener noreferrer">MINSAL</a> · Actualización automática cada 24 horas</p>
		<p class="mt-1">Desarrollado por <a href="https://github.com/ceomarin" class="underline hover:text-gray-600" target="_blank" rel="noopener noreferrer">César Marin</a></p>
	</footer>
</Layout>

<!-- ============================================================
     BUSCADOR — JavaScript vanilla con sanitización
     ============================================================ -->
<script>
	// Esperamos a que el DOM esté listo
	document.addEventListener("DOMContentLoaded", () => {
		const buscador = document.getElementById("buscador") as HTMLInputElement;
		const grid = document.getElementById("grid-farmacias");
		const sinResultados = document.getElementById("sin-resultados");
		const contadorNumero = document.getElementById("contador-numero");

		if (!buscador || !grid || !sinResultados || !contadorNumero) return;

		// Todas las cards del grid
		const cards = Array.from(grid.querySelectorAll("article"));

		buscador.addEventListener("input", () => {
			// SANITIZACIÓN: usamos textContent para leer el valor
			// Esto evita que un input malicioso inyecte HTML
			const temp = document.createElement("div");
			temp.textContent = buscador.value;
			const query = temp.textContent?.toLowerCase().trim() ?? "";

			// Normalización básica: eliminar tildes para búsqueda flexible
			// Ej: "ñuñoa" y "nunoa" encuentran el mismo resultado
			const normalizar = (str: string) =>
				str
					.normalize("NFD")
					.replace(/[\u0300-\u036f]/g, "")
					.toLowerCase();

			const queryNorm = normalizar(query);

			let visibles = 0;

			cards.forEach((card) => {
				// Leemos los atributos data- que pusimos en FarmaciaCard
				const comuna = card.getAttribute("data-comuna") ?? "";
				const nombre = card.getAttribute("data-nombre") ?? "";

				// Comparamos query normalizado contra datos normalizados
				const coincide = queryNorm === "" || normalizar(comuna).includes(queryNorm) || normalizar(nombre).includes(queryNorm);

				if (coincide) {
					(card as HTMLElement).style.display = "";
					visibles++;
				} else {
					(card as HTMLElement).style.display = "none";
				}
			});

			// Actualizar contador
			contadorNumero.textContent = String(visibles);

			// Mostrar/ocultar mensaje sin resultados
			if (visibles === 0) {
				sinResultados.classList.remove("hidden");
			} else {
				sinResultados.classList.add("hidden");
			}
		});
	});
</script>
