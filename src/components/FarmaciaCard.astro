---
// src/components/FarmaciaCard.astro
// ============================================================
// Componente de card para mostrar una farmacia de turno
// Recibe los datos de una farmacia y los renderiza visualmente
// ============================================================

// Definición de props — los datos que debe recibir este componente
interface Props {
    nombre: string;
    direccion: string;
    telefono: string;
    comuna: string;
    localidad: string;
    hora_apertura: string;
    hora_cierre: string;
    dia: string;
    fecha: string;
    comuna_busqueda: string;
    nombre_busqueda: string;
}

const { nombre, direccion, telefono, comuna, localidad, hora_apertura, hora_cierre, dia, fecha, comuna_busqueda, nombre_busqueda } = Astro.props;

// ============================================================
// LÓGICA: ¿Está abierta ahora?
// ============================================================
// Obtenemos la hora actual en Chile (UTC-3 / UTC-4 según DST)
const ahora = new Date();
const horaChile = new Date(ahora.toLocaleString("en-US", { timeZone: "America/Santiago" }));
const minutosAhora = horaChile.getHours() * 60 + horaChile.getMinutes();

// Parseamos HH:MM:SS a minutos totales desde medianoche
function parsearHora(horaStr: string): number {
    const [h, m] = horaStr.split(":").map(Number);
    return h * 60 + m;
}

const minutosApertura = parsearHora(hora_apertura);
const minutosCierre = parsearHora(hora_cierre);

// Caso especial detectado en Paso 1:
// Si cierre < apertura significa que cruza medianoche
// Ej: apertura 09:00 (540 min), cierre 08:59 (539 min) = abierta casi 24h
let estaAbierta: boolean;
if (minutosCierre < minutosApertura) {
    // Turno que cruza medianoche: abierta si es >= apertura O <= cierre
    estaAbierta = minutosAhora >= minutosApertura || minutosAhora <= minutosCierre;
} else {
    // Turno normal: abierta si está entre apertura y cierre
    estaAbierta = minutosAhora >= minutosApertura && minutosAhora <= minutosCierre;
}
console.log(`${nombre} | apertura: ${minutosApertura} | cierre: ${minutosCierre} | ahora: ${minutosAhora} | abierta: ${estaAbierta}`);
// Formateamos las horas para mostrar sin segundos: "09:00:00" → "09:00"
const horaDisplay = (h: string) => h.slice(0, 5);
---

<!-- ============================================================
     TEMPLATE: Card visual de la farmacia
     Todas las variables se escapan automáticamente (anti-XSS)
     ============================================================ -->
<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex flex-col gap-3 hover:shadow-md transition-shadow duration-200" data-comuna={Astro.props.comuna_busqueda} data-nombre={Astro.props.nombre_busqueda}>
    <!-- Header: nombre + badge de estado -->
    <div class="flex items-start justify-between gap-2">
        <h2 class="text-lg font-bold text-gray-800 leading-tight">
            {nombre}
        </h2>

        <!-- Badge "Abierta ahora" / "Cerrada" -->
        {
            estaAbierta ? (
                <span class="shrink-0 inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-semibold px-2.5 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse" />
                    Abierta
                </span>
            ) : (
                <span class="shrink-0 inline-flex items-center gap-1 bg-gray-100 text-gray-500 text-xs font-semibold px-2.5 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full" />
                    Cerrada
                </span>
            )
        }
    </div>

    <!-- Comuna y localidad -->
    <div class="flex items-center gap-1.5 text-sm text-blue-600 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-2.007 3.913-5.107 3.913-9.077A8.183 8.183 0 0012 2.183 8.183 8.183 0 003.8 10.25c0 3.97 1.969 7.07 3.913 9.077a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.25a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path>
        </svg>
        {comuna} — {localidad}
    </div>

    <!-- Dirección -->
    <div class="flex items-start gap-1.5 text-sm text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        {direccion}
    </div>

    <!-- Horario -->
    <div class="flex items-center gap-1.5 text-sm text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        {dia} · {horaDisplay(hora_apertura)} – {horaDisplay(hora_cierre)}
    </div>

    <!-- Teléfono — solo si existe -->
    {
        telefono && (
            <a href={`tel:${telefono}`} class="flex items-center gap-1.5 text-sm text-emerald-600 font-medium hover:text-emerald-700 transition-colors w-fit">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                {telefono}
            </a>
        )
    }
</article>
